From: Richard Acayan <mailingradian@gmail.com>
Date: Wed, 13 Sep 2023 19:32:36 -0400
Subject: [PATCH] drm/panel: samsung-sofef00-bonito: move dsi commands to
 disable function

DSI commands are no longer allowed in the unprepare function. Move it to
a new disable function so that the panel can successfully turn off.

Signed-off-by: Richard Acayan <mailingradian@gmail.com>
---
 .../gpu/drm/panel/panel-samsung-sofef00-bonito.c   | 50 ++++++++++------------
 1 file changed, 23 insertions(+), 27 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-samsung-sofef00-bonito.c b/drivers/gpu/drm/panel/panel-samsung-sofef00-bonito.c
index cb4c7e8..333265b 100644
--- a/drivers/gpu/drm/panel/panel-samsung-sofef00-bonito.c
+++ b/drivers/gpu/drm/panel/panel-samsung-sofef00-bonito.c
@@ -75,63 +75,58 @@ static int sofef00_on(struct sofef00 *ctx)
 	return 0;
 }
 
-static int sofef00_off(struct sofef00 *ctx)
+static int sofef00_prepare(struct drm_panel *panel)
 {
-	struct mipi_dsi_device *dsi = ctx->dsi;
-	struct device *dev = &dsi->dev;
+	struct sofef00 *ctx = to_sofef00(panel);
+	struct device *dev = &ctx->dsi->dev;
 	int ret;
 
-	ret = mipi_dsi_dcs_set_display_off(dsi);
-	if (ret < 0) {
-		dev_err(dev, "Failed to set display off: %d\n", ret);
-		return ret;
-	}
+	if (ctx->prepared)
+		return 0;
 
-	ret = mipi_dsi_dcs_enter_sleep_mode(dsi);
+	sofef00_reset(ctx);
+
+	ret = sofef00_on(ctx);
 	if (ret < 0) {
-		dev_err(dev, "Failed to enter sleep mode: %d\n", ret);
+		dev_err(dev, "Failed to initialize panel: %d\n", ret);
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
 		return ret;
 	}
-	msleep(120);
 
+	ctx->prepared = true;
 	return 0;
 }
 
-static int sofef00_prepare(struct drm_panel *panel)
+static int sofef00_disable(struct drm_panel *panel)
 {
 	struct sofef00 *ctx = to_sofef00(panel);
-	struct device *dev = &ctx->dsi->dev;
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	struct device *dev = &dsi->dev;
 	int ret;
 
-	if (ctx->prepared)
-		return 0;
-
-	sofef00_reset(ctx);
+	ret = mipi_dsi_dcs_set_display_off(dsi);
+	if (ret < 0) {
+		dev_err(dev, "Failed to set display off: %d\n", ret);
+		return ret;
+	}
 
-	ret = sofef00_on(ctx);
+	ret = mipi_dsi_dcs_enter_sleep_mode(dsi);
 	if (ret < 0) {
-		dev_err(dev, "Failed to initialize panel: %d\n", ret);
-		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		dev_err(dev, "Failed to enter sleep mode: %d\n", ret);
 		return ret;
 	}
+	msleep(120);
 
-	ctx->prepared = true;
 	return 0;
 }
 
 static int sofef00_unprepare(struct drm_panel *panel)
 {
 	struct sofef00 *ctx = to_sofef00(panel);
-	struct device *dev = &ctx->dsi->dev;
-	int ret;
 
 	if (!ctx->prepared)
 		return 0;
 
-	ret = sofef00_off(ctx);
-	if (ret < 0)
-		dev_err(dev, "Failed to un-initialize panel: %d\n", ret);
-
 	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
 
 	ctx->prepared = false;
@@ -173,6 +168,7 @@ static int sofef00_get_modes(struct drm_panel *panel,
 
 static const struct drm_panel_funcs sofef00_panel_funcs = {
 	.prepare = sofef00_prepare,
+	.disable = sofef00_disable,
 	.unprepare = sofef00_unprepare,
 	.get_modes = sofef00_get_modes,
 };
