# /bin/bash
#
# Early WIP; missing:
# - check if the current branch is one with the Linux sources
# - arkify-infra-mainline-latest is ignored for now
# - anything to update the ark-infra, which is where things get messy
# - anything for next and stable branches

#
# go
#
set -e
current_branch=$(git rev-parse --abbrev-ref HEAD)

#
# add stuff we need
#
echo "* Adding remote 'arkify'".
git remote add -t arkify-infra-mainline -t arkify-infra-mainline -t mainline -t arkify-arkify arkify https://gitlab.com/knurd42/linux.git/

echo "* Fetching remote 'arkify'".
git fetch --quiet arkify 

# create a "mainline" branch, which the ark-infra requires to seperate upstream
# from downstream. FIXME: Would a remote work? IIRC it does not, but I might be
# mistaken (Thorsten)

echo "* Creating branch 'arkify-upstream-${current_branch}'."
merge_base="$(git merge-base "${current_branch}" arkify/arkify-infra-mainline)"
git branch --force --quiet "arkify-upstream-${current_branch}" "${merge_base}"

echo "* Creating branch 'arkify-infra-mainline'."
git branch --quiet --track arkify-infra-mainline arkify/arkify-infra-mainline
git checkout --quiet arkify-infra-mainline

echo "* Adjusting ark-infra configuration in redhat/Makefile.variables."
echo $'\n'"DISTLOCALVERSION ?= .$(whoami)" >> redhat/Makefile.variables
# FIXME: this hardcodes a few things:
#  BUMP_RELEASE (might not be a good idea for this usecase)
#  DISTRO=fedora (breaks RHEL support)
#  VERSION_ON_UPSTREAM=1 (wrong for stable)
sed -i '
	s!^\(BUMP_RELEASE \?.\?=\)\(.*\)!\1no! ;
	s!^\(DIST \?.\?=\)\(.*\)!\1 .fc40! ;
	s!^\(DIST_BRANCH \?.\?=\)\(.*\)!\1 '"${current_branch}"'! ;
	s!^\(DISTRO \?.\?=\)\(.*\)!\1 fedora! ;
	s!^\(PATCHLIST_URL \?.\?=\)\(.*\)!\1 none! ;
	s!^\(RELEASED_KERNEL \?.\?=\)\(.*\)!\11! ;
	s!^\(UPSTREAM_BRANCH \?.\?=\)\(.*\)!\1 '"arkify-upstream-${current_branch}"'! ;
	s!\(VERSION_ON_UPSTREAM \?.\?=\)\(.*\)!\1 1! ;
       ' redhat/Makefile.variables
git commit --quiet -s -m 'local ark-infra configuration' redhat/Makefile.variables

#
# import ark-infra
#
echo "* Adding ark-infra to branch "${current_branch}.
git checkout --quiet "${current_branch}"
git archive --format=tar arkify-infra-mainline makefile Makefile.rhelver redhat/ .copr | tar -x
# FIXME: is this actually needed?
sed -i '/# We are using a recursive / i include Makefile.rhelver\n' Makefile
git add Makefile makefile Makefile.rhelver redhat/
git add -f .copr redhat/kabi/kabi-module/kabi*
git commit --quiet -s -m "import ark-infra"
echo Done!
echo
echo "Now run 'make dist-srpm' and then use something like"
echo "'mock redhat/rpm/SRPMS/kernel-*.src.rpm' to build the SRPM."
