_afy_perform_startup()
{
	set -e

	# check Fedora
	if ! [[ -e /etc/os-release ]] || ! grep 'NAME="Fedora Linux"' /etc/os-release &> /dev/null; then
		echo "Aborting: arkify currently only supports Fedora Linux."
		exit
	fi

	if ! LC_ALL=C git status 2>/dev/null | grep '^nothing to commit, working tree clean' &> /dev/null; then
		echo "Aborting: uncommitted changes or untracked files present." >&2
		exit 1
	fi

	# check git & kernel
	if [[ ! -d '.git' ]] || [[ $(head -n 1 'README' 2> /dev/null) != 'Linux kernel' ]]; then
		echo "Aborting: this does not look like Git repository with the Linux sources."
		exit 1
	fi

	# check required packages
	local missing_pkgs=''
	# following list taken from https://cki-project.gitlab.io/kernel-ark/
	for pkg in git make gcc flex bison bzip2 rpm-build python3-pyyaml; do
		if ! rpm -q "${pkg}" &> /dev/null; then
			missing_pkgs+=" ${pkg}"
		fi
	done
	if [[ "${missing_pkgs}" ]]; then
		echo "Aborting, please install the following packages${missing_pkgs}"
		exit
	fi

	_afy_target_branch=$(git rev-parse --abbrev-ref HEAD)
	if [[ -e "$(git rev-parse --show-toplevel)/Next/SHA1s" ]]; then
		_afy_target_kind=next
	elif grep -e '^SUBLEVEL = [1-9]' "$(git rev-parse --show-toplevel)"/Makefile &> /dev/null; then
		_afy_target_kind="$(make -s kernelversion)"
		_afy_target_kind="stable-${_afy_target_kind%.*}"
	else
		_afy_target_kind=mainline
	fi
}


_afy_ensure_remote_present()
{
	if ! git remote -v | grep -e '^arkify[[:blank:]]*https://gitlab.com/knurd42/linux.git/' &> /dev/null; then
		echo "* Adding remote 'arkify'".
		git remote add -t arkify-arkify arkify https://gitlab.com/knurd42/linux.git/
	fi
	local remote_branches
	remote_branches="$(git branch --list -r 'arkify*')"
	for branch in arkify-infra-"${_afy_target_kind}" arkify-upstream-"${_afy_target_kind}"; do
		if ! echo "${remote_branches}" | grep -E "^[[:blank:]] arkify/${branch}$" &> /dev/null; then
			git remote set-branches --add arkify "${branch}"
		fi
	done
}


_afy_fetch_arkify()
{
	echo "* Fetching remote 'arkify'".
	git fetch --quiet arkify
}


_afy_handle_arkify-upstream-branch()
{
	# create a branch the ark-infra requires to separate upstream from downstream.
	# FIXME: Would a remote work? IIRC it does not, but I might be # mistaken (Thorsten).
	local merge_base
	merge_base="$(git merge-base "${_afy_target_branch}" arkify/arkify-upstream-"${_afy_target_kind}")"
	if ! git branch -l | grep "^[[:blank:]]*arkify-upstream-${_afy_target_branch}" &> /dev/null; then
		echo "* Creating branch 'arkify-upstream-${_afy_target_branch}' based on '$(git describe "${merge_base}")'."
		git branch --quiet "arkify-upstream-${_afy_target_branch}" "${merge_base}"
		return
	fi

	local current_head
	current_head="$(git rev-parse arkify-upstream-"${_afy_target_branch}")"
	if  ! [[ "${current_head}" == "${merge_base}" ]]; then
		echo "* Force updating 'arkify-upstream-${_afy_target_branch}' to '$(git describe "${merge_base}")' (was: '${current_head:0:14}'."
		git branch --force --quiet "arkify-upstream-${_afy_target_branch}" "${merge_base}"
	fi
}


_afy_handle_arkify-infra-branch()
{
	local date_upstream_branch
	date_upstream="$(git show -s --format=%ct arkify-upstream-"${_afy_target_branch}")"

	while read arkify_tagname tagdate; do
		if (( tagdate > date_upstream )); then
			break;
		fi
	done < <(git tag --sort=creatordate --format '%(refname:strip=2) %(creatordate:unix)' -l arkify-infra-"${_afy_target_kind}"-2*)
	# fallback
	if [[ ! "${arkify_tagname}" ]]; then
		arkify_tagname=arkify-infra-"${_afy_target_kind}"
		# another fallback
		if ! git rev-parse arkify-infra-"${arkify_tagname}" &> /dev/null; then
			arkify_tagname=arkify-infra-mainline
		fi
	fi

	# create a branch with the ark-infra to allow local changes
	if ! git branch -l | grep "^[[:blank:]]*arkify-infra-${_afy_target_branch}" &> /dev/null; then
		echo "* Creating branch 'arkify-infra-${_afy_target_branch}' based on '${arkify_tagname}'."
		git branch --quiet arkify-infra-"${_afy_target_branch}" ${arkify_tagname}

		echo "* Checking out branch 'arkify-infra-${_afy_target_branch}'."
		git checkout --quiet arkify-infra-"${_afy_target_branch}"

		echo "* Adjusting ark-infra configuration in 'redhat/Makefile.variables'."
		echo $'\n'"DISTLOCALVERSION ?= .$(whoami)" >> redhat/Makefile.variables
		# FIXME: this hardcodes a few things:
		#  BUMP_RELEASE (might not be a good idea for this usecase)
		#  DISTRO=fedora (breaks RHEL support)
		#  VERSION_ON_UPSTREAM=1 (wrong for stable)
		sed -i '
			s!^\(DISTRO \?.\?=\)\(.*\)!\1 fedora! ;
			s!^\(PATCHLIST_URL \?.\?=\)\(.*\)!\1 none! ;
			s!^\(RELEASED_KERNEL \?.\?=\)\(.*\)!\11! ;
			s!\(VERSION_ON_UPSTREAM \?.\?=\)\(.*\)!\1 1! ;
		       ' redhat/Makefile.variables
		git commit --quiet -s -m 'local ark-infra configuration' redhat/Makefile.variables
	else
		local merge_base
		merge_base="$(git merge-base arkify-infra-"${_afy_target_branch}" "arkify/arkify-infra-${_afy_target_kind}")"
		if [[ "$(git rev-parse arkify/arkify-infra-"${_afy_target_kind}")" != "${merge_base}" ]]; then
			echo "* Merging ark-infra changes from arkify/arkify-infra-${_afy_target_kind}."
			git checkout --quiet arkify-infra-"${_afy_target_branch}"
			git merge arkify/arkify-infra-"${_afy_target_kind}"
		fi
	fi
}


_afy_import_arkify-infra()
{
	if [[ "$(git rev-parse --abbrev-ref HEAD)" != "${_afy_target_branch}" ]]; then
		echo "* Checking out '${_afy_target_branch}'."
		git checkout --quiet "${_afy_target_branch}"
	fi

	rm -rf makefile Makefile.rhelver redhat/
	# note: omitting Kconfig.redhat here and in related commands on purpose:
	git archive --format=tar arkify-infra-"${_afy_target_branch}" makefile Makefile.rhelver redhat/ .copr | tar -x
	sed -i '
		s!^\(UPSTREAM_BRANCH \?.\?=\)\(.*\)!\1 '"arkify-upstream-${_afy_target_branch}"'! ;
	       ' redhat/Makefile.variables
	# FIXME: is this actually needed?
	if ! grep -E '^include Makefile.rhelver$' Makefile &>/dev/null; then
		sed -i '/# We are using a recursive / i include Makefile.rhelver\n' Makefile
	fi
	git add makefile Makefile.rhelver Makefile redhat
	git add -f .copr
	if ! git diff --cached --exit-code &> /dev/null; then
		echo "* Importing ark infrastructure from 'arkify-infra-${_afy_target_branch}'."
		git commit --quiet -s -m "bulk import ark-infra"
	else
		echo "* Nothing to import, ark infrastructure is up to date with 'arkify-infra-${_afy_target_branch}'."
	fi
}


# define two vairables that _afy_perform_startup will set
_afy_target_branch=''
_afy_target_kind=''
_afy_perform_startup

# go
_afy_ensure_remote_present
_afy_fetch_arkify
_afy_handle_arkify-upstream-branch
_afy_handle_arkify-infra-branch
_afy_import_arkify-infra

# finish
echo $'\n'"Done; now run 'make dist-srpm' and then use something like"
echo "'mock redhat/rpm/SRPMS/kernel-*.src.rpm' to build the SRPM."
