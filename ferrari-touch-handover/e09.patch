+/*
+ * E09 TEST HARNESS ONLY (not for merging): replay parts of the vendor
+ * driver's suspend/resume register sequence with single-byte writes.
+ *  bit0 0x01: T7 IDLE, ACTV, A2I = 0 (vendor suspend)
+ *  bit3 0x08: T97 inst0/1/2 CTRL = 3, T19[3] = 0 (vendor resume, keys/gpio)
+ *  bit1 0x02: T7 A2I, ACTV, IDLE = values read at init (vendor resume)
+ *  bit2 0x04: 100 ms later T6 CALIBRATE = 1, wait for clear
+ *  bit4 0x10: T6 REPORTALL = 1
+ *  bit5 0x20: T7 RUN via upstream mxt_set_t7_power_cfg() 2-byte block write
+ *  bit6 0x40: T7 deep sleep via upstream 2-byte block write
+ */
+static ssize_t mxt_e09_seq_store(struct device *dev,
+				 struct device_attribute *attr,
+				 const char *buf, size_t count)
+{
+	struct mxt_data *data = dev_get_drvdata(dev);
+	struct i2c_client *client = data->client;
+	struct mxt_object *obj;
+	unsigned int seq;
+	int err = 0, i;
+
+	if (kstrtouint(buf, 0, &seq))
+		return -EINVAL;
+	if (!data->T7_address || !data->T6_address)
+		return -ENODEV;
+
+	dev_info(dev, "E09 seq 0x%02x start\n", seq);
+	if (seq & 0x40)
+		err |= mxt_set_t7_power_cfg(data, MXT_POWER_CFG_DEEPSLEEP);
+	if (seq & 0x01)
+		for (i = 0; i < 3; i++)
+			err |= mxt_write_reg(client, data->T7_address + i, 0);
+	if (seq & 0x08) {
+		obj = mxt_get_object(data, 97);
+		if (obj)
+			for (i = 0; i < 3; i++)
+				err |= mxt_write_reg(client,
+						     obj->start_address + 10 * i, 3);
+		obj = mxt_get_object(data, MXT_SPT_GPIOPWM_T19);
+		if (obj)
+			err |= mxt_write_reg(client, obj->start_address + 3, 0);
+	}
+	if (seq & 0x02)
+		for (i = 2; i >= 0; i--)
+			err |= mxt_write_reg(client, data->T7_address + i,
+					     data->e09_t7[i]);
+	if (seq & 0x20)
+		err |= mxt_set_t7_power_cfg(data, MXT_POWER_CFG_RUN);
+	if (seq & 0x04) {
+		msleep(100);
+		err |= mxt_t6_command(data, MXT_COMMAND_CALIBRATE, 1, true);
+	}
+	if (seq & 0x10)
+		err |= mxt_t6_command(data, MXT_COMMAND_REPORTALL, 1, false);
+	dev_info(dev, "E09 seq 0x%02x done err %d\n", seq, err);
+
+	return err ? -EIO : count;
+}
+
+static DEVICE_ATTR(e09_seq, S_IWUSR, NULL, mxt_e09_seq_store);
