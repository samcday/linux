#!/usr/bin/env python3
# usage: rsh 'command'   (or command on stdin with '-')
import os as _os, base64 as _b64
_HDR={'content-type':'application/json'}
if _os.environ.get('OPENCODE_PW'):  # basic auth (user "opencode"); the password only ever comes from the environment
    _HDR['Authorization']='Basic '+_b64.b64encode(('opencode:'+_os.environ['OPENCODE_PW']).encode()).decode()
import json,sys,urllib.request,urllib.error
import os; B=os.environ['OPENCODE_URL']  # the OpenCode server URL (ask Sam)
H='ses_f2d09a645ffevmQnJc0IpS3MsG'
import base64
cmd=sys.stdin.read() if sys.argv[1]=='-' else sys.argv[1]
cmd='echo '+base64.b64encode(cmd.encode()).decode()+' | base64 -d | bash 2>&1'
req=urllib.request.Request(f'{B}/session/{H}/shell',data=json.dumps({'agent':'build','command':cmd}).encode(),headers=_HDR)
import time
for attempt in range(14):
    try:
        r=json.load(urllib.request.urlopen(req,timeout=900)); break
    except urllib.error.URLError as e:
        # CONNECT-level failures never reach the server: safe to retry
        if not any(k in str(e) for k in ('Tunnel connection failed','Connection reset','handshake','timed out','EOF occurred')) or attempt==13: raise
        print('[rsh] retry after',e,file=sys.stderr); time.sleep(min(2**(attempt+1),20))
for p in r.get('parts',[]):
    if p['type']=='tool':
        st=p['state']
        out=st.get('output') or st.get('metadata',{}).get('output') or ''
        sys.stdout.write(out if out.endswith('\n') else out+'\n')
        if st.get('status')!='completed': print('[status]',st.get('status'),st.get('error',''),file=sys.stderr)
