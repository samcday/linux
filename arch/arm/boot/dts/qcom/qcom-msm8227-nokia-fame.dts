/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/pinctrl/qcom,pmic-gpio.h>

#include "qcom-msm8227.dtsi"
#include "pm8038.dtsi"

/ {
	model = "Nokia Lumia 520";
	compatible = "nokia,fame", "qcom,msm8227";
	chassis-type = "handset";

	aliases {
		display0 = &mdp;
		mmc0 = &sdcc1;
		serial0 = &gsbi5_serial;
	};

	chosen {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		stdout-path = "serial0:115200n8";

		framebuffer0: framebuffer@80400000 {
			compatible = "simple-framebuffer";
			reg = <0x80400000 0x00177000>;
			width = <480>;
			height = <800>;
			stride = <1920>;
			format = "a8r8g8b8";
			clocks = <&mmcc MDP_CLK>,
				 <&mmcc MDP_AHB_CLK>,
				 <&mmcc MDP_AXI_CLK>,
				 <&mmcc MDP_LUT_CLK>,
				 <&mmcc MDP_VSYNC_CLK>,
				 <&mmcc DSI_M_AHB_CLK>,
				 <&mmcc DSI_S_AHB_CLK>,
				 <&mmcc AMP_AHB_CLK>,
				 <&mmcc DSI_CLK>,
				 <&mmcc DSI1_BYTE_CLK>,
				 <&mmcc DSI_PIXEL_CLK>,
				 <&mmcc DSI1_ESC_CLK>;
			power-domains = <&mmcc MDP_PD>;
			vdda-supply = <&pm8038_l2>;
			avdd-supply = <&pm8038_l8>;
			vddio-supply = <&pm8038_l11>;
			display = <&mdp>;
		};
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&gpio_keys_default_state>;
		pinctrl-names = "default";

		key-volume-up {
			label = "Volume Up";
			gpios = <&pm8038_gpio 3 GPIO_ACTIVE_LOW>;
			debounce-interval = <62>;
			linux,code = <KEY_VOLUMEUP>;
			wakeup-source;
		};

		key-volume-down {
			label = "Volume Down";
			gpios = <&pm8038_gpio 8 GPIO_ACTIVE_LOW>;
			debounce-interval = <62>;
			linux,code = <KEY_VOLUMEDOWN>;
			wakeup-source;
		};

		key-camera-focus {
			label = "Camera Focus";
			gpios = <&pm8038_gpio 11 GPIO_ACTIVE_LOW>;
			debounce-interval = <62>;
			linux,code = <KEY_CAMERA_FOCUS>;
		};

		key-camera {
			label = "Camera Snapshot";
			gpios = <&pm8038_gpio 10 GPIO_ACTIVE_LOW>;
			debounce-interval = <62>;
			linux,code = <KEY_CAMERA>;
			wakeup-source;
		};
	};

	memory@80200000 {
		device_type = "memory";
		reg = <0x80200000 0x08c00000>,
		      <0x90000000 0x10000000>;
	};

};

&gsbi5 {
	status = "okay";
};

&gsbi5_serial {
	status = "okay";
};

&pm8038 {
	interrupts-extended = <&tlmm 104 IRQ_TYPE_LEVEL_LOW>;
};

&pm8038_gpio {
	gpio_keys_default_state: gpio-keys-default-state {
		pins = "gpio3", "gpio8", "gpio10", "gpio11";
		function = PMIC_GPIO_FUNC_NORMAL;
		input-enable;
		bias-pull-up;
		drive-push-pull;
		power-source = <PM8038_GPIO_L11>;
		qcom,drive-strength = <PMIC_GPIO_STRENGTH_NO>;
	};
};

&rpm {
	regulators {
		compatible = "qcom,rpm-pm8038-regulators";

		pm8038_l2: l2 {
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
			bias-pull-down;
		};

		pm8038_l3: l3 {
			regulator-min-microvolt = <3075000>;
			regulator-max-microvolt = <3075000>;
			bias-pull-down;
		};

		pm8038_l4: l4 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			bias-pull-down;
		};

		pm8038_l5: l5 {
			regulator-always-on;
			regulator-boot-on;
			regulator-min-microvolt = <2950000>;
			regulator-max-microvolt = <2950000>;
			bias-pull-down;
		};

		pm8038_l8: l8 {
			regulator-min-microvolt = <2800000>;
			regulator-max-microvolt = <3000000>;
			bias-pull-down;
		};

		pm8038_l11: l11 {
			regulator-always-on;
			regulator-boot-on;
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			bias-pull-down;
		};
	};
};

&sdcc1 {
	pinctrl-0 = <&sdcc1_default_state>;
	pinctrl-1 = <&sdcc1_sleep_state>;
	pinctrl-names = "default", "sleep";
	vmmc-supply = <&pm8038_l5>;
	vqmmc-supply = <&pm8038_l11>;
	status = "okay";
};

&tlmm {
	panel_reset_state: panel-reset-state {
		pins = "gpio58";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
		output-high;
	};

	sdcc1_default_state: sdcc1-default-state {
		clk-pins {
			pins = "sdc1_clk";
			drive-strength = <16>;
			bias-disable;
		};

		cmd-pins {
			pins = "sdc1_cmd";
			drive-strength = <10>;
			bias-pull-up;
		};

		data-pins {
			pins = "sdc1_data";
			drive-strength = <10>;
			bias-pull-up;
		};
	};

	sdcc1_sleep_state: sdcc1-sleep-state {
		clk-pins {
			pins = "sdc1_clk";
			drive-strength = <2>;
			bias-disable;
		};

		cmd-pins {
			pins = "sdc1_cmd";
			drive-strength = <2>;
			bias-pull-up;
		};

		data-pins {
			pins = "sdc1_data";
			drive-strength = <2>;
			bias-pull-up;
		};
	};
};

&usb1 {
	status = "okay";
};

&usb_hs1_phy {
	v1p8-supply = <&pm8038_l4>;
	v3p3-supply = <&pm8038_l3>;
	qcom,init-seq = /bits/ 8 <0x01 0x38 0x02 0x14>;
};

&mdp {
	status = "okay";
};

&mdp_port0 {
	status = "okay";
};

&mdp_port1 {
	status = "okay";
};

&dsi0 {
	vdda-supply = <&pm8038_l2>;
	avdd-supply = <&pm8038_l8>;
	vddio-supply = <&pm8038_l11>;
	status = "okay";

	panel: panel@0 {
		compatible = "nokia,teisko";
		reg = <0>;

		reset-gpios = <&tlmm 58 GPIO_ACTIVE_LOW>;
		pinctrl-0 = <&panel_reset_state>;
		pinctrl-names = "default";

		port {
			panel_in: endpoint {
				remote-endpoint = <&dsi0_out>;
			};
		};
	};
};

&dsi0_out {
	data-lanes = <1 2>;
	remote-endpoint = <&panel_in>;
};

&dsi0_phy {
	vddio-supply = <&pm8038_l11>;
	status = "okay";
};
